{
  "name": "WYSIWYG MD",
  "short_name": "WYMD",
  "description": "A Markdown Editor and Reader",
  "start_url": "/wysiwygmd/",
  "scope": "/wysiwygmd/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#6366F1",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "1024x1024",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/wysiwygmd/",
      "accept": {
        "text/markdown": [
          ".md"
        ]
      }
    }
  ],
  "share_target": {
    "action": "/wysiwygmd/_share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "md_file",
          "accept": [
            ".md",
            ".markdown",
            "text/markdown",
            "text/plain"
          ]
        }
      ]
    }
  }
}